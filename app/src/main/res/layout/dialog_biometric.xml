<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_fingerprint"
        android:contentDescription="@string/biometric_authentication"
        app:tint="@color/primary_color"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/biometric_authentication"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvBiometricMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/use_biometric_to_login"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/secondary_text"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEnableBiometric"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/enable_biometric"
        android:backgroundTint="@color/primary_color"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSkipBiometric"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/skip_for_now"
        android:backgroundTint="@color/transparent"
        android:textColor="@color/primary_color"
        android:textSize="14sp" />

</LinearLayout>